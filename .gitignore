# Environment and secrets
.env
*.env.*
*.key
*.pem
*.token
secrets/

# OS files
.DS_Store
Thumbs.db

# Docker volumes
data/

# Editor files
.vscode/
.idea/

# Python/cache
__pycache__/
*.py[cod]
.pytest_cache/

# Logs/runtime
logs/
*.log

# Browser auth/session data. Do not commit cookies or local sessions.
browser-profile/
workspace-agent-browser-profile/
browser-downloads/
browser-screenshots/

# Local tunnel/autostart files may contain server/user/SSH details.
scripts/*cdp*.sh
scripts/*cdp*.plist

# Local binaries/dependencies/vendor caches
bin/
vendor/
node_modules/

# External repos are cloned here for inspection/work but should remain separate Git repos.
external-repos/

# Generated document/image previews
marathi_pdf_preview/
marathi_pdf_preview2/
marathi_pdf_preview3/
pdf_pages_preview/

# Large/source documents kept local unless explicitly needed
*.pdf
*.xlsx
*.xls
*.zip
*.mp4
*.mp3
*.ogg

# Generated LMS/client-work packaging intermediates / QA renders
# Keep workspace outputs local unless explicitly packaged for repo storage.
workspace/**/extracted_assets/
workspace/**/reference_renders/
workspace/**/video_slides_en/
workspace/**/video_slides_mr/
workspace/**/*contact_sheet*.jpg
workspace/**/qa_*.jpg
workspace/unzipped_*/
