#!/usr/bin/env bash
set -euo pipefail

PORT="${HERMES_DASHBOARD_PORT:-9119}"
HOST="${HERMES_DASHBOARD_HOST:-127.0.0.1}"
BOARD="${HERMES_KANBAN_BOARD:-manas-os}"
LOG_DIR="/root/Hermes-Agent/logs"
PID_FILE="$LOG_DIR/hermes-dashboard.pid"
mkdir -p "$LOG_DIR"

cmd="${1:-status}"

is_running() {
  [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$cmd" in
  start)
    hermes kanban boards switch "$BOARD" >/dev/null 2>&1 || true
    hermes kanban init >/dev/null 2>&1 || true
    if is_running; then
      echo "Dashboard already running: PID $(cat "$PID_FILE") at http://$HOST:$PORT"
      exit 0
    fi
    nohup hermes dashboard --host "$HOST" --port "$PORT" --no-open --tui > "$LOG_DIR/hermes-dashboard.log" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 2
    if is_running; then
      echo "Dashboard started: PID $(cat "$PID_FILE") at http://$HOST:$PORT"
      echo "Board: $BOARD"
    else
      echo "Dashboard failed to start. Log: $LOG_DIR/hermes-dashboard.log"
      exit 1
    fi
    ;;
  stop)
    if is_running; then
      kill "$(cat "$PID_FILE")" || true
      sleep 1
      rm -f "$PID_FILE"
      echo "Dashboard stopped."
    else
      rm -f "$PID_FILE"
      hermes dashboard --stop 2>/dev/null || true
      echo "No dashboard PID found; requested hermes dashboard stop."
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    echo "Profiles:"
    hermes profile list
    echo
    echo "Board:"
    hermes kanban boards list
    echo
    echo "Assignees:"
    hermes kanban --board "$BOARD" assignees
    echo
    if is_running; then
      echo "Dashboard: running PID $(cat "$PID_FILE") at http://$HOST:$PORT"
    else
      echo "Dashboard: not running via this script"
      hermes dashboard --status 2>/dev/null || true
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 2
    ;;
esac
