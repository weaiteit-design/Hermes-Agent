#!/usr/bin/env bash
set -euo pipefail

DASH_HOST="0.0.0.0"
DASH_PORT="${HERMES_DASHBOARD_PORT:-9119}"
ROOT="/root/Hermes-Agent"
LOG_DIR="$ROOT/logs"
mkdir -p "$LOG_DIR" "$ROOT/bin"

CLOUDFLARED="$ROOT/bin/cloudflared"
if [ ! -x "$CLOUDFLARED" ]; then
  ARCH=$(uname -m)
  case "$ARCH" in
    x86_64|amd64) URL='https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64' ;;
    aarch64|arm64) URL='https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64' ;;
    *) echo "Unsupported arch: $ARCH"; exit 1 ;;
  esac
  curl -L --fail --retry 3 -o "$CLOUDFLARED" "$URL"
  chmod +x "$CLOUDFLARED"
fi

# Stop old dashboard/tunnel started by this setup. Safe: only matching dashboard/tunnel commands.
pkill -f "hermes dashboard --host .* --port $DASH_PORT" 2>/dev/null || true
pkill -f "cloudflared tunnel --url http://127.0.0.1:$DASH_PORT" 2>/dev/null || true
sleep 1

nohup hermes dashboard --host "$DASH_HOST" --port "$DASH_PORT" --no-open --tui --insecure > "$LOG_DIR/hermes-dashboard.log" 2>&1 &
echo $! > "$LOG_DIR/hermes-dashboard.pid"
sleep 3
curl -fsS "http://127.0.0.1:$DASH_PORT/" >/dev/null

: > "$LOG_DIR/cloudflared-dashboard.log"
nohup "$CLOUDFLARED" tunnel --url "http://127.0.0.1:$DASH_PORT" --no-autoupdate --loglevel info > "$LOG_DIR/cloudflared-dashboard.log" 2>&1 &
echo $! > "$LOG_DIR/cloudflared-dashboard.pid"

for i in $(seq 1 30); do
  URL=$(grep -oE 'https://[-a-z0-9]+\.trycloudflare\.com' "$LOG_DIR/cloudflared-dashboard.log" | tail -1 || true)
  if [ -n "$URL" ]; then
    echo "$URL" > "$LOG_DIR/dashboard-public-url.txt"
    echo "Dashboard tunnel: $URL"
    exit 0
  fi
  sleep 1
done

echo "Tunnel started but URL not found yet. Check $LOG_DIR/cloudflared-dashboard.log"
exit 1
