#!/usr/bin/env bash
set -euo pipefail
ROOT="/root/Hermes-Agent"
PORT="${MANAS_DASHBOARD_PORT:-9121}"
LOG_DIR="$ROOT/logs"
mkdir -p "$LOG_DIR" "$ROOT/bin"

# Stop sensitive generic Hermes dashboard/tunnel if running from earlier setup.
pkill -f 'cloudflared tunnel --url http://127.0.0.1:9119' 2>/dev/null || true
pkill -f 'hermes dashboard --host .* --port 9119' 2>/dev/null || true

# Start custom safe dashboard.
pkill -f "manas_os_dashboard.py" 2>/dev/null || true
sleep 1
nohup env MANAS_DASHBOARD_PORT="$PORT" python3 "$ROOT/manas_os_dashboard.py" > "$LOG_DIR/manas-os-dashboard.log" 2>&1 &
echo $! > "$LOG_DIR/manas-os-dashboard.pid"
sleep 2
curl -fsS "http://127.0.0.1:$PORT/" >/dev/null

# Install cloudflared if needed.
CLOUDFLARED="$ROOT/bin/cloudflared"
if [ ! -x "$CLOUDFLARED" ]; then
  ARCH=$(uname -m)
  case "$ARCH" in
    x86_64|amd64) URL='https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64' ;;
    aarch64|arm64) URL='https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64' ;;
    *) echo "Unsupported arch: $ARCH"; exit 1 ;;
  esac
  curl -L --fail --retry 3 -o "$CLOUDFLARED" "$URL"
  chmod +x "$CLOUDFLARED"
fi

pkill -f "cloudflared tunnel --url http://127.0.0.1:$PORT" 2>/dev/null || true
: > "$LOG_DIR/manas-os-cloudflared.log"
nohup "$CLOUDFLARED" tunnel --url "http://127.0.0.1:$PORT" --no-autoupdate --loglevel info > "$LOG_DIR/manas-os-cloudflared.log" 2>&1 &
echo $! > "$LOG_DIR/manas-os-cloudflared.pid"

for i in $(seq 1 35); do
  URL=$(grep -oE 'https://[-a-z0-9]+\.trycloudflare\.com' "$LOG_DIR/manas-os-cloudflared.log" | tail -1 || true)
  if [ -n "$URL" ]; then
    KEY=$(cat "$LOG_DIR/manas-dashboard-token.txt")
    FULL="$URL/?key=$KEY"
    echo "$FULL" > "$LOG_DIR/manas-os-public-url.txt"
    echo "$FULL"
    exit 0
  fi
  sleep 1
done

echo "Tunnel started but URL not found yet. Check $LOG_DIR/manas-os-cloudflared.log" >&2
exit 1
