diff --git a/App.tsx b/App.tsx
index 1c9a379..ab3511e 100644
--- a/App.tsx
+++ b/App.tsx
@@ -1,9 +1,7 @@
 import React, { useState, useEffect } from 'react';
-import { View, Text, StyleSheet } from 'react-native';
-import { SafeAreaProvider } from 'react-native-safe-area-context';
-import { StatusBar } from 'expo-status-bar';
 import { Onboarding } from './components/Onboarding';
 import { Dashboard } from './components/Dashboard';
+import { WurtleMascot } from './components/WurtleMascot';
 import { UserContext } from './types';
 import { storageService } from './services/storageService';
 
@@ -44,38 +42,25 @@ export default function App() {
 
   if (loading) {
     return (
-      <SafeAreaProvider>
-        <StatusBar style="light" />
-        <View style={styles.loadingContainer}>
-          <Text style={styles.loadingText}>Loading Delta...</Text>
-        </View>
-      </SafeAreaProvider>
+      <div className="min-h-screen bg-[#050505] flex flex-col items-center justify-center px-8 text-center">
+        <div className="relative mb-4">
+          <div className="absolute inset-4 rounded-full bg-blue-500/20 blur-3xl" />
+          <WurtleMascot animation="loading" className="relative w-44 h-44" label="Wurtle is preparing WiseAI" />
+        </div>
+        <p className="text-[10px] uppercase tracking-[0.35em] text-blue-200/80">Wurtle is syncing your AI edge</p>
+        <h1 className="mt-4 text-2xl font-semibold text-white">Loading WiseAI</h1>
+      </div>
     );
   }
 
   return (
-    <SafeAreaProvider>
-      <StatusBar style="light" />
+    <>
       {!user || !user.onboardingComplete ? (
         <Onboarding onComplete={handleOnboardingComplete} />
       ) : (
         <Dashboard user={user} onSignOut={handleSignOut} />
       )}
-    </SafeAreaProvider>
+    </>
   );
 }
 
-const styles = StyleSheet.create({
-  loadingContainer: {
-    flex: 1,
-    backgroundColor: '#000000',
-    alignItems: 'center',
-    justifyContent: 'center',
-  },
-  loadingText: {
-    color: '#ffffff',
-    fontSize: 16,
-    fontWeight: '300',
-    letterSpacing: 2,
-  },
-});
