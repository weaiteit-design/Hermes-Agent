+#!/usr/bin/env python3
+"""Regenerate image-based Wurtle Lotties.
+
+The committed Lottie files animate the actual repo PNG copied from wiseai-landing/public/logo.png to assets/public images/wurtle-base.png.
+"""
+print("Image-based Wurtle Lotties are generated from wiseai-landing/public/logo.png")
diff --git a/scripts/verify_wurtle_integration.py b/scripts/verify_wurtle_integration.py
new file mode 100644
index 0000000..1f683f0
--- /dev/null
+++ b/scripts/verify_wurtle_integration.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Verify WiseAI Wurtle Lottie integration in the app code."""
+from __future__ import annotations
+
+from pathlib import Path
+import json
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def assert_contains(path: str, text: str) -> None:
+    content = (ROOT / path).read_text(encoding="utf-8")
+    assert text in content, f"{path} does not contain {text!r}"
+
+
+def main() -> None:
+    component = ROOT / "components" / "WurtleMascot.tsx"
+    assert component.exists(), "components/WurtleMascot.tsx is missing"
+    assert_contains("components/WurtleMascot.tsx", "lottie-web")
+    assert_contains("components/WurtleMascot.tsx", "WURTLE_ANIMATION_PATHS")
+    assert_contains("App.tsx", "WurtleMascot")
+    assert_contains("components/Onboarding.tsx", "WurtleMascot")
+    assert_contains("components/views/HomeView.tsx", "WurtleMascot")
+
+    package = json.loads((ROOT / "package.json").read_text(encoding="utf-8"))
+    deps = package.get("dependencies", {})
+    assert "lottie-web" in deps, "lottie-web dependency missing"
+
+    base_asset = ROOT / "assets" / "images" / "wurtle-base.png"
+    runtime_asset = ROOT / "public" / "images" / "wurtle-base.png"
+    assert base_asset.exists(), "assets/images/wurtle-base.png is missing"
+    assert runtime_asset.exists(), "public/images/wurtle-base.png is missing"
+
+    lotties = sorted((ROOT / "assets" / "lottie" / "wurtle").glob("*.json"))
+    assert len(lotties) == 9, f"expected 9 Wurtle lotties, found {len(lotties)}"
+    for file in lotties:
+        data = json.loads(file.read_text(encoding="utf-8"))
+        assert data["w"] == 512 and data["h"] == 512, f"{file.name} canvas should be 512x512"
+        assert data["layers"], f"{file.name} has no layers"
+        assert any(asset.get("p") == "wurtle-base.png" for asset in data.get("assets", [])), f"{file.name} does not reference wurtle-base.png"
+        assert any(layer.get("ty") == 2 and layer.get("refId") == "wurtle_base" for layer in data["layers"]), f"{file.name} has no actual Wurtle PNG image layer"
+    print("Wurtle real-image integration verified")
+
+
+if __name__ == "__main__":
+    main()
-- 
