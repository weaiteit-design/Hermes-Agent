diff --git a/components/WurtleMascot.tsx b/components/WurtleMascot.tsx
new file mode 100644
index 0000000..f193698
--- /dev/null
+++ b/components/WurtleMascot.tsx
@@ -0,0 +1,75 @@
+import React, { useEffect, useRef } from 'react';
+import lottie, { AnimationItem } from 'lottie-web';
+
+export type WurtleAnimation =
+  | 'idle'
+  | 'wave'
+  | 'celebrate'
+  | 'thinking'
+  | 'reading'
+  | 'loading'
+  | 'success'
+  | 'retry'
+  | 'boost';
+
+export const WURTLE_ANIMATION_PATHS: Record<WurtleAnimation, string> = {
+  idle: '/lottie/wurtle/01_wurtle_idle_blink.json',
+  wave: '/lottie/wurtle/02_wurtle_wave_hello.json',
+  celebrate: '/lottie/wurtle/03_wurtle_celebrate_stars.json',
+  thinking: '/lottie/wurtle/04_wurtle_thinking_bubble.json',
+  reading: '/lottie/wurtle/05_wurtle_reading_lesson.json',
+  loading: '/lottie/wurtle/06_wurtle_loading_loop.json',
+  success: '/lottie/wurtle/07_wurtle_success_check.json',
+  retry: '/lottie/wurtle/08_wurtle_sad_retry.json',
+  boost: '/lottie/wurtle/09_wurtle_lesson_complete_boost.json',
+};
+
+interface WurtleMascotProps {
+  animation?: WurtleAnimation;
+  loop?: boolean;
+  autoplay?: boolean;
+  className?: string;
+  label?: string;
+}
+
+export const WurtleMascot: React.FC<WurtleMascotProps> = ({
+  animation = 'idle',
+  loop = true,
+  autoplay = true,
+  className = 'w-32 h-32',
+  label = 'Wurtle, your WiseAI learning companion',
+}) => {
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const animationRef = useRef<AnimationItem | null>(null);
+
+  useEffect(() => {
+    if (!containerRef.current) return;
+
+    animationRef.current?.destroy();
+    animationRef.current = lottie.loadAnimation({
+      container: containerRef.current,
+      renderer: 'svg',
+      loop,
+      autoplay,
+      path: WURTLE_ANIMATION_PATHS[animation],
+      rendererSettings: {
+        preserveAspectRatio: 'xMidYMid meet',
+        progressiveLoad: true,
+      },
+    });
+
+    return () => {
+      animationRef.current?.destroy();
+      animationRef.current = null;
+    };
+  }, [animation, autoplay, loop]);
+
+  return (
+    <div
+      ref={containerRef}
+      className={className}
+      role="img"
+      aria-label={label}
+    />
+  );
+};
