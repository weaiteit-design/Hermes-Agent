+<!doctype html><html><head><meta charset="utf-8"><title>Wurtle real-image Lottie preview</title><script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script><style>body{font-family:Inter,system-ui;background:#f8fafc;margin:0;padding:28px;color:#0f172a}h1{margin:0 0 6px}.base{display:flex;gap:20px;align-items:center;background:white;border:1px solid #e2e8f0;border-radius:22px;padding:18px;margin:18px 0 28px;box-shadow:0 10px 30px #0f172a14}.base img{height:130px;object-fit:contain;background:linear-gradient(45deg,#eef2f7 25%,transparent 25%),linear-gradient(-45deg,#eef2f7 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eef2f7 75%),linear-gradient(-45deg,transparent 75%,#eef2f7 75%);background-size:18px 18px;background-position:0 0,0 9px,9px -9px,-9px 0px;border-radius:16px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:white;border:1px solid #e2e8f0;border-radius:22px;padding:14px;box-shadow:0 10px 30px #0f172a12}.card>div{height:220px}p{font-size:13px;color:#475569}</style></head><body><h1>Wurtle real-image animation pack</h1><p>These Lotties animate the actual repo PNG: <code>public/images/wurtle-base.png</code>.</p><div class="base"><img src="/images/wurtle-base.png"><div><b>Base image being animated</b><p>Source: wiseai-landing/public/logo.png<br>Runtime: Delta-/public/images/wurtle-base.png</p></div></div><div class="grid"><div class="card"><div id="a1"></div><p>01_wurtle_idle_blink.json</p></div><div class="card"><div id="a2"></div><p>02_wurtle_wave_hello.json</p></div><div class="card"><div id="a3"></div><p>03_wurtle_celebrate_stars.json</p></div><div class="card"><div id="a4"></div><p>04_wurtle_thinking_bubble.json</p></div><div class="card"><div id="a5"></div><p>05_wurtle_reading_lesson.json</p></div><div class="card"><div id="a6"></div><p>06_wurtle_loading_loop.json</p></div><div class="card"><div id="a7"></div><p>07_wurtle_success_check.json</p></div><div class="card"><div id="a8"></div><p>08_wurtle_sad_retry.json</p></div><div class="card"><div id="a9"></div><p>09_wurtle_lesson_complete_boost.json</p></div></div><script>lottie.loadAnimation({container:document.getElementById("a1"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/01_wurtle_idle_blink.json"});lottie.loadAnimation({container:document.getElementById("a2"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/02_wurtle_wave_hello.json"});lottie.loadAnimation({container:document.getElementById("a3"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/03_wurtle_celebrate_stars.json"});lottie.loadAnimation({container:document.getElementById("a4"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/04_wurtle_thinking_bubble.json"});lottie.loadAnimation({container:document.getElementById("a5"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/05_wurtle_reading_lesson.json"});lottie.loadAnimation({container:document.getElementById("a6"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/06_wurtle_loading_loop.json"});lottie.loadAnimation({container:document.getElementById("a7"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/07_wurtle_success_check.json"});lottie.loadAnimation({container:document.getElementById("a8"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/08_wurtle_sad_retry.json"});lottie.loadAnimation({container:document.getElementById("a9"),renderer:"svg",loop:true,autoplay:true,path:"/lottie/wurtle/09_wurtle_lesson_complete_boost.json"});</script></body></html>
